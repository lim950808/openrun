# Copy to .env (gitignored) and fill in. apps/api reads it via spring.config.import (ADR-0007 §6).
# Toss test keys: https://developers.tosspayments.com (test_sk_... / test_ck_...). Never commit real values.
OPENRUN_PAYMENT_PG=fake
OPENRUN_TOSS_SECRET_KEY=test_sk_replace_me
OPENRUN_TOSS_CLIENT_KEY=test_ck_replace_me
OPENRUN_TOSS_WEBHOOK_SECRET=replace_me
OPENRUN_TOKEN_SECRET=replace_me_with_openssl_rand_hex_32
# Demo server (ADR-0009). compose reads .env from infra/compose, so pass it explicitly:
#   docker compose --env-file .env -f infra/compose/compose.yaml --profile demo up -d --wait   (docs/deploy.md)
# Local bootRun imports this file too (spring.config.import), so this stays EMPTY here: a value makes /api/admin/*
# require X-Admin-Token and the bench scripts then need the same value exported (ADR-0009 §3).
# On the demo server only: OPENRUN_ADMIN_TOKEN=$(openssl rand -hex 32)
OPENRUN_ADMIN_TOKEN=
OPENRUN_DEMO_SHOWTIME_EVERY=PT0S
# PT0S = off. Demo server: PT15M (a showtime opens every 15 minutes, ADR-0009 §4).
DEMO_SITE_ADDRESS=:80
# :80 = plain HTTP. On the server put your domain (e.g. openrun.example.com) for automatic HTTPS.
OPENRUN_IMAGE_TAG=latest
# sha-xxxxxxx (a tag published by publish-images.yml) to roll back.
POSTGRES_PASSWORD=openrun
# Change on the server. Used by both the postgres container and the API's OPENRUN_DB_PASSWORD.
